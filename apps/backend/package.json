{
  "name": "@test-monorepo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate:sqlite --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.10.3",
    "@test-monorepo/types": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.30.7",
    "dotenv": "^16.4.5",
    "hono": "^4.3.5",
    "pino": "^9.1.0",
    "uuidv7": "^1.0.0",
    "zod": "^3.23.8",
    "@hono/zod-validator": "^0.2.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.17"
  }
}
