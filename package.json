{
  "name": "test-monorepo-v3",
  "private": true,
  "version": "0.1.0",
  "description": "Todo monorepo workspace encompassing backend, web, mobile, and shared packages",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "pnpm run build:shared",
    "build:shared": "pnpm --filter @test-monorepo/types run build && pnpm --filter @test-monorepo/api-client run build",
    "dev": "turbo run dev --parallel --filter=@test-monorepo/backend --filter=@test-monorepo/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
