{
  "name": "@test-monorepo/types",
  "version": "0.1.0",
  "description": "Shared domain types and schemas for the Todo application",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
